{
	"version": 1,
	"entries": [
		{
			"id": "a001",
			"pattern": "[ובכלמשה]{0,3}מינים(?![א-ת])",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"מינים\" - species / סוגים (\"מינים בסכנת הכחדה\", \"ארבעת המינים\"). ההתאמה הייתה על \"מיני\" שבתוכה."
		},
		{
			"id": "a002",
			"pattern": "[ובכלמשה]{0,3}מין האנושי",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"המין האנושי\" - האנושות."
		},
		{
			"id": "a003",
			"pattern": "תת[-־ ]?ה?מין",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"תת-מין\" - מונח טקסונומי."
		},
		{
			"id": "a004",
			"pattern": "\\[\\[מין \\(טקסונומיה\\)[^\\]]*\\]\\]",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "קישור לערך \"מין (טקסונומיה)\" - הטקסט המוצג בו (\"מין\") הוא במובן species."
		},
		{
			"id": "a005",
			"pattern": "[ובכלמשה]{0,3}מין (?:אנדמי|חדש|נדיר|נכחד|פולש|מוגן|צמח|עץ|שיח|ציפור|עוף|דג|חרק|יונק|זוחל|פרפר|חיפושית|נמלה|עכביש|מהנדס|ביולוגי|קרוב|מקומי|אחר|נוסף|ממשפחת|בסוג|בסוגה|של)(?![א-ת])",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"מין\" ואחריו מילה ביולוגית - species. בכוונה לא \"מין אחד\"/\"מין זה\" וכו' (לא חד-משמעי)."
		},
		{
			"id": "a006",
			"pattern": "(?:כל|שני|שלושה|ארבעה|חמישה|מגוון|הרבה|מספר|כמה|שאר|ושאר|וכל|ובכל|בכל|לכל|מכל|שבעת|ארבעת|שבעה) מיני(?![א-ת])",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"כל מיני\", \"שבעת מיני\" - סוגי (צירוף סמיכות), לא \"מיני\" במובן sexual."
		},
		{
			"id": "a007",
			"pattern": "מיני[-־](?=[א-ת])",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"מיני-אלבום\", \"מיני-סדרה\" - התחילית mini."
		},
		{
			"id": "a008",
			"pattern": "[ובכלמשה]{0,3}מיני(?:אטור|מום|מלי|מאל|סטר|סטרי|אפוליס|בוס|ות אמר)[א-ת]*",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "מיניאטורה, מינימום, מינימלי, מיניסטר, מיניאפוליס, מיניבוס - מילים לועזיות שמתחילות ב\"מיני\"."
		},
		{
			"id": "a009",
			"pattern": "[ובכלמשה]{0,3}אונסק[\"״]?ו",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "אונסק\"ו (UNESCO)."
		},
		{
			"id": "a010",
			"pattern": "[ובכלמשה]{0,3}[\"״]?אונסקו[\"״]?",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"אונסקו\" בלי גרשיים."
		},
		{
			"id": "a011",
			"pattern": "[ובכלמשה]{0,3}בואנוס",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "בואנוס איירס."
		},
		{
			"id": "a012",
			"pattern": "[ובכלמשה]{0,3}אוונס(?![א-ת])",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "שם המשפחה אוונס (Evans)."
		},
		{
			"id": "a013",
			"pattern": "(?<![א-ת])[א-ת]*[יקתר]אנוס(?![א-ת])",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "שמות רומיים ולועזיים שמסתיימים ב-יאנוס/קאנוס (אדריאנוס, טראיאנוס, וטיקאנוס, תאנוס). \"אנוס\" עצמו, \"האנוס\" ו\"לאנוס\" לא נכללים - לפני האל\"ף יש רק אותיות שימוש."
		},
		{
			"id": "a014",
			"pattern": "[ובכלמשה]{0,3}אנוסי(?:ם| (?:ספרד|פורטוגל|משהד|מאיורקה))(?![א-ת])",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"האנוסים\", \"אנוסי ספרד\" - יהודים שנאלצו להמיר את דתם. מושג היסטורי-הלכתי."
		},
		{
			"id": "a015",
			"pattern": "(?:ב?שוגג או ב?|מחמת |מפני |מתוך |ב)אונס(?![א-ת])",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"אונס\" במובן ההלכתי - כפייה (\"בשוגג או באונס\", \"מחמת אונס\"). בכוונה לא \"אונס\" לבדו."
		},
		{
			"id": "a016",
			"pattern": "\\[\\[אונס \\(הלכה\\)[^\\]]*\\]\\]",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "קישור לערך \"אונס (הלכה)\"."
		},
		{
			"id": "a017",
			"pattern": "[ובכלמשה]{0,3}(?:נ?חשפ(?:ה|ו|נו|תי|ת)|חושפ(?:ת|ים|ות)?|נחשפים|נחשפות|היחשפות|להיחשף|לחשוף)(?![א-ת])",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "הפועל \"לחשוף\" (גילה, revealed): חשפה, חשפו, נחשפים, חושפת. לא \"חשופה\" (בו\"ו - התואר) ולא \"חשפנית\"."
		},
		{
			"id": "a018",
			"pattern": "[ובכלמשה]{0,3}[\"״]?סקס(?:וני|ה[-־]|הומן)[א-ת-]*",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "סקסוניה, הסקסונית, סקסה-קובורג-גותה (שמות מקום/שושלת), סקסהומן (מבצר בפרו)."
		},
		{
			"id": "a019",
			"pattern": "[ובכלמשה]{0,3}סקסופו?ן[א-ת]*",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "סקסופון, סקסופוניסט."
		},
		{
			"id": "a020",
			"pattern": "[ובכלמשה]{0,3}[\"״]?טרא?נס[-־]?(?!ג'?נדר|ג׳נדר|קסואל|וסט|ווסט|ים(?![א-ת])|ית(?![א-ת])|יות(?![א-ת]))[א-ת]+",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"טרנס\" כתחילית לועזית (טרנסילבניה, טרנספורמר, טרנס-אטלנטי). \"טרנס\" לבדו, \"טרנסג'נדר\", \"טרנסית/טרנסים\" - לא נכללים."
		},
		{
			"id": "a021",
			"pattern": "[ובכלמשה]{0,3}[\"״]?דראגו(?:ן|נ[א-ת]*)",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "דראגון (dragon) - לא \"דראג\"."
		},
		{
			"id": "a022",
			"pattern": "[ובכלמשה]{0,3}רומנ(?:סק|טיק)[א-ת]*",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "רומנסקי (סגנון אדריכלי), רומנטיקה (התנועה באמנות ובספרות)."
		},
		{
			"id": "a023",
			"pattern": "(?:התקופה|המוזיקה|המוסיקה|הספרות|הסגנון|האמנות|השירה|התנועה|האסכולה|הציור) הרומנטית",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "התקופה/התנועה הרומנטית באמנות - לא רומנטיקה במובן אהבה."
		},
		{
			"id": "a024",
			"pattern": "[ובכלמשה]{0,3}רומנ(?:ים|י)? (?:היסטורי|ביכורים|גרפי|בלשי|ספרותי|מתח|הרפתקאות|פנטזיה|מדע בדיוני|קצר|ארוך|מאת|שכתב|שלו|שלה|זה)(?![א-ת])",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"רומן\" במובן ספר (novel) - \"רומן היסטורי\", \"רומן מאת\". \"רומן עם\" (פרשת אהבים) לא נכלל."
		},
		{
			"id": "a025",
			"pattern": "\\bass(?!hole|es\\b)[a-z]+",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "מילים באנגלית שמתחילות ב-ass (assistant, association, assembly). ההתאמה הייתה על \"(\\s|^)ass\"."
		},
		{
			"id": "a026",
			"pattern": "\\[\\[המפץ הגדול \\(סדרת טלוויזיה\\)(?:\\|[^\\]]*)?\\]\\]|(?:סדרת הטלוויזיה|הסדרה|סיטקום|בסדרה)\\s+\"?המפץ הגדול",
			"status": "suggested",
			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "הסדרה \"המפץ הגדול\" (The Big Bang Theory), ולא התאוריה."
		}
	]
}
