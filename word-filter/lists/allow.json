			"reviewed": false,
			"sources": [
				"הצעת Claude"
			],
			"note": "\"אונסקו\" בלי גרשיים.",
			"kind": "hide"
		},
		{
			"id": "a011",
			"pattern": "[ובכלמשה]{0,3}בואנוס",
			"status": "suggested",
